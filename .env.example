# ---- Supabase (create a free project at https://supabase.com, then Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM provider: "ollama" (default, local) or "groq" (hosted fallback for demo day) ----
LLM_PROVIDER=ollama

# Ollama runs outside docker; from inside compose the API reaches it via host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434/v1
GENERATION_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Only needed if LLM_PROVIDER=groq (free tier key from https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ---- Verification ----
# Students must sign up with an email on this domain (e.g. students.katyisd.org)
STUDENT_EMAIL_DOMAIN=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same Supabase project as above (the anon key is safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
